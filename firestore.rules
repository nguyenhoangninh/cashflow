rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Xác thực người dùng Google
    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    // 2. Lấy thông tin phân quyền theo Firebase UID
    function memberDoc() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function hasRole(allowedRoles) {
      return verified()
        && exists(memberDoc())
        && get(memberDoc()).data.role in allowedRoles;
    }

    // 3. Phân quyền
    function reader() {
      return hasRole(['viewer', 'editor', 'admin']);
    }

    function editor() {
      return hasRole(['editor', 'admin']);
    }

    function admin() {
      return hasRole(['admin']);
    }

    // 4. Phân quyền người dùng
    // Không cho phép tự cấp hoặc nâng quyền
    match /members/{uid} {
      allow get: if verified()
        && request.auth.uid == uid;

      allow list, create, update, delete: if false;
    }

    // 5. Cấu hình hệ thống
    // Chỉ Admin được chỉnh sửa
    match /config/{id} {
      allow read: if id == 'main' && reader();

      allow create, update, delete:
        if id == 'main' && admin();
    }

    // 6. Payment Requests
    match /payments/{id} {
      allow read: if reader();
      allow write: if editor();
    }

    // 7. Receipts
    match /receipts/{id} {
      allow read: if reader();
      allow write: if editor();
    }

    // 8. Foreign Exchange
    match /fx/{id} {
      allow read: if reader();
      allow write: if editor();
    }

    // 9. Bank Adjustments
    match /bankAdj/{id} {
      allow read: if reader();
      allow write: if editor();
    }

    // 10. Bank Reconciliation
    match /recon/{id} {
      allow read: if reader();
      allow write: if editor();
    }

    // 11. Bank Accounts
    match /accounts/{id} {
      allow read: if reader();
      allow write: if editor();
    }

    // 12. Operating Expenses
    match /opex/{id} {
      allow read: if reader();
      allow write: if editor();
    }

    // 13. Từ chối mọi truy cập khác
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
