rules_version = '2';

// Production roles are created/revoked by a Firebase project administrator in
// the Firebase Console (or privileged backend), never by this browser app.
// members/{auth.uid}: { role: "viewer" | "editor" | "admin" }.
// Do not use test-mode rules or allow every signed-in Google account.
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function memberDoc() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }
    function hasRole(allowedRoles) {
      return verified()
        && exists(memberDoc())
        && get(memberDoc()).data.role in allowedRoles;
    }
    function reader() { return hasRole(['viewer', 'editor', 'admin']); }
    function editor() { return hasRole(['editor', 'admin']); }
    function admin() { return hasRole(['admin']); }

    // Account sees its own role, but cannot grant or elevate any role.
    match /members/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Global configuration changes are restricted to admins.
    match /config/{id} {
      allow read: if id == 'main' && reader();
      allow create, update, delete: if id == 'main' && admin();
    }

    // Business data: viewers read, editors/admins maintain transactions.
    match /payments/{id} { allow read: if reader(); allow write: if editor(); }
    match /receipts/{id} { allow read: if reader(); allow write: if editor(); }
    match /fx/{id} { allow read: if reader(); allow write: if editor(); }
    match /bankAdj/{id} { allow read: if reader(); allow write: if editor(); }
    match /recon/{id} { allow read: if reader(); allow write: if editor(); }
    match /accounts/{id} { allow read: if reader(); allow write: if editor(); }
    match /opex/{id} { allow read: if reader(); allow write: if editor(); }

    // Unknown data paths remain inaccessible.
    match /{document=**} { allow read, write: if false; }
  }
}
